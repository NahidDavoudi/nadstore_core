# NadStore Core — environment template (section 17 of the architecture document).
# Copy to .env and fill real values. NEVER commit the real .env.
# All times are UTC inside the app.

# --- Runtime -----------------------------------------------------------------
# development | test | production
NODE_ENV=production
# all | api | worker
ROLE=all
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- HTTP --------------------------------------------------------------------
PORT_PUBLIC=3000
PORT_INTERNAL=3001
# Public API hostname, used to build Telegram webhook URLs
API_PUBLIC_HOST=api.nadstore.ir
# Docker network subnet; X-Forwarded-For is trusted only from here
TRUST_PROXY_CIDR=172.16.0.0/12

# --- Registry database (operational user) ------------------------------------
REGISTRY_DB_HOST=mysql
REGISTRY_DB_PORT=3306
REGISTRY_DB_NAME=nad_registry
REGISTRY_DB_USER=nad_core_app
REGISTRY_DB_PASSWORD=REPLACE_ME

# --- Provisioner user (DDL; used by migrations and provisioning only) ---------
PROV_DB_USER=nad_core_prov
PROV_DB_PASSWORD=REPLACE_ME

# --- Shop database address returned by /internal/resolve ----------------------
SHOP_DB_HOST=mysql
SHOP_DB_PORT=3306

# --- Crypto (section 14) -------------------------------------------------------
# JSON mapping numeric key versions to base64-encoded 32-byte master keys.
# Generate one: openssl rand -base64 32
MASTER_KEYS={"1":"REPLACE_ME_WITH_openssl_rand_-base64_32"}
MASTER_KEY_CURRENT=1
# WARNING: keep an offline copy of MASTER_KEYS — losing it means losing every
# encrypted secret permanently.

# --- Shared secrets ------------------------------------------------------------
# Between store (PHP) and core; minimum 32 bytes.
# Generate: openssl rand -base64 32
INTERNAL_SECRET=REPLACE_ME_WITH_openssl_rand_-base64_32

# --- Admin ---------------------------------------------------------------------
# JWT signing secret for admin access tokens; separate from master keys; min 32 bytes.
ADMIN_JWT_SECRET=REPLACE_ME_WITH_openssl_rand_-base64_32
# Allowed Origin for the admin refresh cookie
ADMIN_ORIGIN=https://admin.nadstore.ir

# --- Shop migrations ------------------------------------------------------------
# Read-only volume mount of the store (PHP) migrations directory
SHOP_MIGRATIONS_DIR=/app/shop-migrations

# --- Media (phase 8) -------------------------------------------------------------
MEDIA_DIR=/data/media
MEDIA_BASE_URL=https://media.nadstore.ir

# --- Worker -----------------------------------------------------------------------
WORKER_CONCURRENCY=5
