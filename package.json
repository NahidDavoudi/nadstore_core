{
  "name": "nadstore-core",
  "version": "0.1.0",
  "private": true,
  "description": "NadStore Core — tenant registry and shared services for the NadStore platform",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "tsx watch src/main.api.ts",
    "dev:worker": "tsx watch src/main.worker.ts",
    "dev:cli": "tsx",
    "build": "tsc -p tsconfig.build.json",
    "start:api": "node dist/main.api.js",
    "start:worker": "node dist/main.worker.js",
    "cli": "node dist/main.cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:boundaries": "node scripts/check-boundaries.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run test:boundaries"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.12.7",
    "kysely": "^0.29.7",
    "mysql2": "^3.24.6",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.3.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
